{% comment %}
  Unified education entry renderer for both RenderCV and JSONResume formats
  Handles both:
  - RenderCV: institution, area, studyType (or degree), start_date, end_date, location, courses, highlights
  - JSONResume: institution, area, studyType, startDate, endDate, location, courses, highlights

  Local override of al_folio_cv's education.liquid: same left-column date-badge
  layout as publications.liquid, but with month/year precision, a plain location
  line underneath (no icon), and no location-icon table row.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="row">
        {% comment %} `capture` keeps the surrounding whitespace, so strip before testing for emptiness {% endcomment %}
        {% capture start_date %}
          {% if entry.start_date %}{{ entry.start_date }}{% elsif entry.startDate %}{{ entry.startDate }}{% endif %}
        {% endcapture %}
        {% assign start_date = start_date | strip %}
        {% capture end_date %}
          {% if entry.end_date %}{{ entry.end_date }}{% elsif entry.endDate %}{{ entry.endDate }}{% endif %}
        {% endcapture %}
        {% assign end_date = end_date | strip %}
        {% capture point_date %}
          {% if entry.date %}{{ entry.date }}{% elsif entry.releaseDate %}{{ entry.releaseDate }}{% endif %}
        {% endcapture %}
        {% assign point_date = point_date | strip %}

        {% assign months = 'Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec' | split: ',' %}

        {% if start_date != '' %}
          {% assign start_parts = start_date | split: '-' %}
          {% assign start_year = start_parts[0] %}
          {% if start_parts[1] %}
            {% assign start_month_index = start_parts[1] | plus: 0 | minus: 1 %}
            {% assign start_label = months[start_month_index] | append: ' ' | append: start_year %}
          {% else %}
            {% assign start_label = start_year %}
          {% endif %}

          {% if end_date != '' %}
            {% assign end_parts = end_date | split: '-' %}
            {% assign end_year = end_parts[0] %}
            {% if end_parts[1] %}
              {% assign end_month_index = end_parts[1] | plus: 0 | minus: 1 %}
              {% assign end_label = months[end_month_index] | append: ' ' | append: end_year %}
            {% else %}
              {% assign end_label = end_year %}
            {% endif %}
          {% else %}
            {% assign end_label = 'Present' %}
          {% endif %}

          {% assign date = start_label | append: ' - ' | append: end_label %}
        {% elsif point_date != '' %}
          {% assign point_parts = point_date | split: '-' %}
          {% assign point_year = point_parts[0] %}
          {% if point_parts[1] %}
            {% assign point_month_index = point_parts[1] | plus: 0 | minus: 1 %}
            {% assign date = months[point_month_index] | append: ' ' | append: point_year %}
          {% else %}
            {% assign date = point_year %}
          {% endif %}
        {% else %}
          {% assign date = null %}
        {% endif %}

        <div class="col-xs-2 col-sm-3 col-md-3 text-center">
          <table class="table-cv" style="width: 100%">
            <tbody>
              <tr>
                <td style="text-align: left">
                  {% if date %}
                    <span
                      class="badge font-weight-bold danger-color-dark text-uppercase align-middle"
                      style="display: block; width: 100%; text-align: center; line-height: 1.15"
                    >
                      {{- date -}}
                    </span>
                  {% endif %}
                </td>
              </tr>
              {% capture location %}
                {% if entry.location %}{{ entry.location }}{% endif %}
              {% endcapture %}
              {% assign location = location | strip %}
              {% if location != '' %}
                <tr>
                  <td style="text-align: left">
                    <p class="location" style="text-align: left; margin: 0.25rem 0 0; white-space: normal">{{ location }}</p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 col-sm-9 col-md-9 mt-2 mt-md-0">
          {% capture study_type %}
            {% if entry.studyType %}{{ entry.studyType }}{% elsif entry.degree %}{{ entry.degree }}{% endif %}
          {% endcapture %}

          {% if entry.url %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">
              <a href="{{ entry.url }}">{{ study_type }}</a>
            </h6>
          {% elsif study_type != '' %}
            <h6 class="title font-weight-bold ml-1 ml-md-4">{{ study_type }}</h6>
          {% endif %}

          {% if entry.institution %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ entry.institution }}</h6>
          {% endif %}

          {% if entry.area %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ entry.area }}</h6>
          {% endif %}

          {% if entry.courses or entry.highlights %}
            <ul class="items">
              {% for item in entry.courses %}
                <li>
                  <span class="item">{{ item }}</span>
                </li>
              {% endfor %}
              {% for item in entry.highlights %}
                <li>
                  <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
